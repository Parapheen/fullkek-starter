{{- $lb := "{{" -}}
{{- $rb := "}}" -}}
{{ printf "%s define \"base\" %s\n" $lb $rb }}
<!doctype html>
<html lang="en"{{- if .Stack.HasFeature "styling-daisyui" }} data-theme="light"{{- end }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content="{{ printf "%s .CSRFToken %s" $lb $rb }}" />
    <title>{{ printf "%s block \"title\" . %s" $lb $rb }}{{ .AppName }}{{ printf "%s end %s" $lb $rb }}</title>
    <link rel="stylesheet" href="/assets/styles/output.css" />
    {{- if .Stack.HasFeature "frontend-htmx" }}
    <script src="/assets/scripts/htmx.min.js" defer></script>
    {{- else if .Stack.HasFeature "frontend-ui-sdk" }}
    <script type="module" src="https://ui-sdk.dev/web@0.1.0-beta.17.js"></script>
    {{- end }}
    {{ printf "%s block \"head\" . %s" $lb $rb }}{{ printf "%s end %s" $lb $rb }}
  </head>
  <body class="{{ printf "%s block \"body_class\" . %s" $lb $rb }}{{- if .Stack.HasFeature "styling-daisyui" }}min-h-screen bg-base-100 text-base-content{{- end }}{{ printf "%s end %s" $lb $rb }}">
    <header>
      {{ printf "%s template \"navbar\" . %s\n" $lb $rb }}
    </header>
    <main>
      {{ printf "%s block \"content\" . %s" $lb $rb }}{{ printf "%s end %s" $lb $rb }}
    </main>
    {{ printf "%s template \"footer\" . %s\n" $lb $rb }}
    <script src="/assets/scripts/csrf.js" defer></script>
    {{ printf "%s block \"scripts\" . %s" $lb $rb }}{{ printf "%s end %s" $lb $rb }}
  </body>
</html>
{{ printf "%s end %s\n" $lb $rb }}
{{- if .Stack.HasFeature "frontend-ui-sdk" }}
{{ printf "%s define \"ui-sdk-showcase\" %s\n" $lb $rb }}
  <section id="get-started" class="mx-auto max-w-6xl px-6 py-16" aria-labelledby="component-showcase-title">
    <h2 id="component-showcase-title" class="text-3xl font-semibold">ui-sdk component showcase</h2>
    <div class="mt-8 grid gap-x-12 gap-y-8 md:grid-cols-2">
      <div class="border-t border-current/20 pt-5">
        <h3 class="mb-4 font-semibold">Tabs</h3>
        <ui-tabs default-value="templates">
          <ui-tabs-list aria-label="Project structure" class="flex flex-wrap gap-2">
            <ui-tabs-tab value="templates">
              <button type="button" class="min-h-11 rounded-lg border border-transparent px-3 aria-selected:border-current">Templates</button>
            </ui-tabs-tab>
            <ui-tabs-tab value="assets">
              <button type="button" class="min-h-11 rounded-lg border border-transparent px-3 aria-selected:border-current">Assets</button>
            </ui-tabs-tab>
          </ui-tabs-list>
          <ui-tabs-panel value="templates">
            <p class="mt-3 text-sm">Edit pages and shared markup in <code>web/templates</code>.</p>
          </ui-tabs-panel>
          <ui-tabs-panel value="assets" hidden>
            <p class="mt-3 text-sm">Serve CSS, scripts, and images from <code>public/assets</code>.</p>
          </ui-tabs-panel>
        </ui-tabs>
      </div>
      <div class="border-t border-current/20 pt-5">
        <h3 class="mb-4 font-semibold">Accordion</h3>
        <ui-accordion default-value="develop">
          <ui-accordion-item value="develop">
            <ui-accordion-header>
              <h4>
                <ui-accordion-trigger>
                  <button type="button" aria-expanded="true" class="min-h-11 w-full rounded-lg px-3 text-left font-medium hover:bg-current/5">
                    How do I start the app?
                  </button>
                </ui-accordion-trigger>
              </h4>
            </ui-accordion-header>
            <ui-accordion-panel>
              <p class="px-3 pb-3 text-sm">Run <code>make go</code> in the generated project.</p>
            </ui-accordion-panel>
          </ui-accordion-item>
          <ui-accordion-item value="components">
            <ui-accordion-header>
              <h4>
                <ui-accordion-trigger>
                  <button type="button" aria-expanded="false" class="min-h-11 w-full rounded-lg px-3 text-left font-medium hover:bg-current/5">
                    How do I add a component?
                  </button>
                </ui-accordion-trigger>
              </h4>
            </ui-accordion-header>
            <ui-accordion-panel hidden>
              <p class="px-3 pb-3 text-sm">Use the <a class="underline" href="https://ui-sdk.dev/web.md">ui-sdk web docs</a> to add the component’s markup to a template.</p>
            </ui-accordion-panel>
          </ui-accordion-item>
        </ui-accordion>
      </div>
      <div class="border-t border-current/20 pt-5">
        <h3 class="mb-4 font-semibold">Toggle</h3>
        <ui-toggle>
          <button type="button" aria-pressed="false" class="min-h-11 rounded-lg border px-4 aria-pressed:bg-slate-900 aria-pressed:text-white">
            Star this project
          </button>
        </ui-toggle>
      </div>
      <div class="border-t border-current/20 pt-5">
        <h3 class="mb-4 font-semibold">Dialog</h3>
        <ui-dialog>
          <ui-dialog-trigger>
            <button type="button" class="min-h-11 rounded-lg border px-4 hover:bg-current/5">View project details</button>
          </ui-dialog-trigger>
          <ui-dialog-content hidden class="fixed inset-0 m-auto h-fit w-xs max-w-[calc(100%-2rem)] rounded-lg border border-slate-200 bg-white p-6 text-slate-900 shadow-xl backdrop:bg-slate-950/40">
            <ui-dialog-title class="text-lg font-semibold">Project details</ui-dialog-title>
            <ui-dialog-description class="mt-2 text-sm">
              {{ .AppName }} runs on {{ if .Stack.HasFeature "http-chi" }}Chi{{ else }}Go’s standard HTTP server{{ end }}.
            </ui-dialog-description>
            <ui-dialog-close>
              <button type="button" class="mt-4 min-h-11 rounded-lg border px-4">Done</button>
            </ui-dialog-close>
          </ui-dialog-content>
        </ui-dialog>
      </div>
    </div>
  </section>
{{ printf "%s end %s\n" $lb $rb }}
{{- end }}
